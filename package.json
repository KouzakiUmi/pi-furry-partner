{
  "name": "pi-furry-partner",
  "version": "2.5.0-preview.5",
  "description": "Umi / 呜咪 — an animated Pi companion with English/中文 UI, quick actions, and an optional character voice.",
  "author": "KouzakiUmi",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KouzakiUmi/pi-furry-partner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/pi-furry-partner.git"
  },
  "bugs": {
    "url": "https://github.com/KouzakiUmi/pi-furry-partner/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/pi-furry-night.json"
    ]
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node scripts/test-site.mjs",
    "build:dsh": "node scripts/build-dsh-client.mjs",
    "test:dsh": "node tests/run-dsh.mjs",
    "build:hd": "python tools/build-editions.py --edition hd-remaster --platform all",
    "build:animated": "python tools/build-editions.py --edition full-animation --platform all",
    "build:all": "python tools/build-editions.py --edition all --platform all",
    "build:prepare": "python tools/build-editions.py --edition all --platform all --prepare-only",
    "build:pi": "python tools/build-editions.py --edition all --platform pi",
    "build:packages:dsh": "python tools/build-editions.py --edition all --platform dsh"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "dsh-plugin",
    "deepseek-harness",
    "furry",
    "mascot",
    "tui",
    "umi",
    "bilingual",
    "chinese-ui"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "cordis.patch.yml",
    "config.json",
    "install.ps1",
    "uninstall.ps1",
    "ASSET_LICENSE.md",
    "NOTICE",
    "lib/*.js",
    "lib/*.mjs",
    "prompts/*.md",
    "themes/*.json",
    "assets/*.json",
    "assets/illustration/*.json",
    "assets/reactions/*/*.json",
    "assets/hires/**",
    "assets/branding/*",
    "assets/animated/**"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "node": ">=18",
      "dshReleases": {
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "compatible",
        "0.2.1-alpha.3": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  }
}
