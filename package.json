  "description": "Umi / 呜咪 — an animated Pi companion with English/中文 UI, quick actions, and an optional character voice.",
  "author": "KouzakiUmi",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KouzakiUmi/pi-furry-partner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/pi-furry-partner.git"
  },
  "bugs": {
    "url": "https://github.com/KouzakiUmi/pi-furry-partner/issues"
  },
