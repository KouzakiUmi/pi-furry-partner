{
  "name": "pi-furry-partner",
  "version": "2.5.1-preview.6",
  "description": "Umi / 呜咪 — an animated Pi companion with English/中文 UI, quick actions, and an optional character voice.",
  "author": "KouzakiUmi",
  "license": "Apache-2.0",
  "homepage": "https://github.com/KouzakiUmi/pi-furry-partner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/pi-furry-partner.git"
  },
  "bugs": {
    "url": "https://github.com/KouzakiUmi/pi-furry-partner/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes/pi-furry-night.json"
    ]
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node scripts/test-site.mjs",
    "build:animated": "python tools/build-editions.py --edition full-animation --platform all",
    "build:all": "python tools/build-editions.py --edition all --platform all",
    "build:prepare": "python tools/build-editions.py --edition all --platform all --prepare-only",
    "build:pi": "python tools/build-editions.py --edition all --platform pi"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "furry",
    "mascot",
    "tui",
    "umi",
    "bilingual",
    "chinese-ui"
  ],
  "files": [
    "index.ts",
    "config.json",
    "install.ps1",
    "uninstall.ps1",
    "ASSET_LICENSE.md",
    "NOTICE",
    "lib/approved-motion-codec.mjs",
    "lib/approved-motion-node.mjs",
    "lib/build-profile.mjs",
    "lib/command-chinese.mjs",
    "lib/editor-controls.mjs",
    "lib/editor-layout.mjs",
    "lib/expressions.mjs",
    "lib/footer.mjs",
    "lib/gesture-video.mjs",
    "lib/gestures.mjs",
    "lib/kitty.mjs",
    "lib/language.mjs",
    "lib/listen.mjs",
    "lib/mascot-autocomplete.mjs",
    "lib/native-prompt.mjs",
    "lib/overlay-visibility.mjs",
    "lib/pi-resources.mjs",
    "lib/poke.mjs",
    "lib/quick-actions.mjs",
    "lib/renderer.mjs",
    "lib/response-latency.mjs",
    "lib/search.mjs",
    "lib/sixel.mjs",
    "lib/state-loop.mjs",
    "lib/styles.mjs",
    "lib/ui-chinese.mjs",
    "lib/watch.mjs",
    "lib/hd/*.mjs",
    "prompts/*.md",
    "themes/*.json",
    "assets/status-*.json",
    "assets/ui-*.json",
    "assets/illustration/*.json",
    "assets/reactions/umi/*.json",
    "assets/animated/**"
  ]
}
